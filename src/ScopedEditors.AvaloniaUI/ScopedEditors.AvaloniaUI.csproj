<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <AssemblyName>ScopedEditors.AvaloniaUI</AssemblyName>
    <PackageId>Bennewitz.Ninja.ScopedEditors.Avalonia</PackageId>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>Avalonia views, converters and behaviours for scoped property editors: the editor wrapper, drag-and-drop, focus and DataGrid behaviours, JSON highlighting, linkified text, and an opt-in Semi.Avalonia theme bundle.</Description>
    <PackageTags>avalonia;editors;converters;behaviors;semi-avalonia</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    JetBrains Mono NL, bundled rather than named, carried across with the source.

    ⛔ WHY BUNDLED: a font STACK is a request, not a guarantee. The same markup rendered three
    different faces across the three platforms. Shipping the file is the only way the drawn
    result is the same everywhere.

    ⭐ NL = the no-ligature cut, and that is a correctness choice rather than a taste one. These
    surfaces show the literal bytes of a config file, a path or a command; a ligature would
    compose `!=` or `->` into one glyph, so what the user reads would stop matching the file.

    ⚠ ~1.2 MB embedded in a published package. Consumers reach the face by
    avares://ScopedEditors.AvaloniaUI/Assets/Fonts#JetBrains Mono NL. Note that the assembly name
    changed with the rename, so a consumer's URI must change with it. A stale URI naming one
    family is NOT silent: it throws InvalidOperationException, "Could not create glyphTypeface",
    the first time text in it is laid out. Only a fallback list is silent, and it draws the next
    face instead. BundledFontTests lays out text by exactly these URIs.

    ⚠ OFL 1.1 requires the licence to travel with the font, so OFL.txt is embedded beside it.
  -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/JetBrainsMonoNL-Regular.ttf" />
    <AvaloniaResource Include="Assets/Fonts/JetBrainsMonoNL-SemiBold.ttf" />
    <AvaloniaResource Include="Assets/Fonts/JetBrainsMonoNL-Bold.ttf" />
    <AvaloniaResource Include="Assets/Fonts/JetBrainsMono-Regular.ttf" />
    <AvaloniaResource Include="Assets/Fonts/JetBrainsMono-Bold.ttf" />
    <AvaloniaResource Include="Assets/Fonts/OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Opt-in Semi.Avalonia theme bundle. Consumers that want Semi styling include
         avares://ScopedEditors.AvaloniaUI/Themes/SemiBundle.axaml from their App.axaml; consumers
         that prefer Fluent simply omit it. PrivateAssets="" lets the Semi assemblies flow
         transitively to consuming apps.
         ⚠ This is the ONLY id in the family that binds a consumer to Semi.Avalonia — that
         opinion is isolated in exactly one package on purpose. -->
    <PackageReference Include="Semi.Avalonia" PrivateAssets="" />
    <PackageReference Include="Semi.Avalonia.DataGrid" PrivateAssets="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ScopedEditors.Abstractions/ScopedEditors.Abstractions.csproj" />
    <ProjectReference Include="../ScopedEditors.ViewModels/ScopedEditors.ViewModels.csproj" />
  </ItemGroup>
</Project>
