<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>Bennewitz.Ninja.ScopedEditors.ViewModels</PackageId>
    <AssemblyName>ScopedEditors.ViewModels</AssemblyName>
    <Description>View-models for scoped property editors — presentation logic with no UI-framework reference at all, so an editor can be built off the UI thread without risk. Property editors, factories, navigation nodes and messages.</Description>
    <PackageTags>mvvm;view-models;editors;property-editor</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- ⭐ The absence of an Avalonia reference here is COMPILER-ENFORCED, not a convention: a
       control reference is a build error, which is what keeps editors safe to build off the UI
       thread. Adding one to "just get at a Dispatcher" removes that guarantee for every caller. -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ScopedEditors.Abstractions/ScopedEditors.Abstractions.csproj" />
  </ItemGroup>
</Project>
