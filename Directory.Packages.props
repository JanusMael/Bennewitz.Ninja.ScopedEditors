<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Versioning">
    <PackageVersion Include="Bennewitz.Ninja.AutoVersioning" Version="2026.3.914" />
  </ItemGroup>

  <ItemGroup Label="UI">
    <!-- Avalonia 12.1.3 for the fix that lets a UI Automation client read a list's selection on
         Windows (AvaloniaUI/Avalonia#22151). DataGrid has no 12.1.3; 12.1.2 is its newest. Semi
         stays at the version OpenForge2k had these projects on when they moved.
         ⚠ trimcheck/expected-warnings.txt comes from DataGrid: re-read it whenever DataGrid moves. -->
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="Semi.Avalonia" Version="12.1.0" />
    <PackageVersion Include="Semi.Avalonia.DataGrid" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup Label="MVVM">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- xunit.v3 on Microsoft.Testing.Platform — see global.json. The VSTest bridge packages are
         deliberately absent; TrxReport is what gives CI its .trx files. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- The family's own assembly rules, run as tests over what this repository ships. -->
    <PackageVersion Include="Bennewitz.Ninja.AssemblyQuality" Version="2026.3.922" />
    <!-- The family's own markup rules, run as tests over the markup this repository ships. -->
    <PackageVersion Include="Bennewitz.Ninja.XamlQuality" Version="2026.3.922" />
    <!-- The headless platform for the ported Avalonia tests. ⚠ Pinned to the SAME version as Avalonia
         above: a newer one pulls a newer Avalonia transitively against the libraries' pin and trips
         central transitive pinning, as the original suite's 12.1.2 did against 12.1.0. -->
    <PackageVersion Include="Avalonia.Headless" Version="12.1.3" />
    <!-- ⚠ Same Microsoft.Testing.Platform line as xunit.v3 3.2.2 (1.9.1). A NEWER TrxReport pins
         the platform above what xunit's bundled MSBuild extension can load, and the failure reads
         as an unrelated loader error. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1" />
  </ItemGroup>
</Project>
